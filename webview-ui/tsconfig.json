  "files": [
    "./src/vite-env.d.ts",
    "./src/webview-api.ts",
    "./src/webview-setup.ts",
    "./src/webview.ts",
    "./src/index-webview-react.tsx",
    "./src/main-webview.tsx"
  ]
}
